# CreatorFlow AI - Environment Configuration

# Database
# Default: SQLite (works immediately without any external services)
# For PostgreSQL: postgresql://USER:PASSWORD@localhost:5432/creatorflow?schema=public
DATABASE_URL="file:./dev.db"

# Authentication & Sessions
JWT_SECRET="creatorflow_super_secret_jwt_key_at_least_32_chars_long_12345"
APP_URL="http://localhost:3000"

# AI Provider Configuration (Optional - Clear indicators shown when absent)
# Supported: openai, anthropic, gemini, groq
AI_PROVIDER="demo"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./public/uploads"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Video Processing (FFmpeg)
# If empty, CreatorFlow checks PATH for 'ffmpeg', and falls back to media tool simulation with clear diagnostic
FFMPEG_PATH=""

# Platform API Integrations (Optional)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
